{
  "components": {
    "schemas": {
      "AuthProviderInfo": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/AuthProviderKind"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "display_name",
          "kind"
        ],
        "title": "AuthProviderInfo",
        "type": "object"
      },
      "AuthProviderKind": {
        "enum": [
          "password",
          "redirect"
        ],
        "title": "AuthProviderKind",
        "type": "string"
      },
      "AuthProviders": {
        "properties": {
          "local_login": {
            "title": "Local Login",
            "type": "boolean"
          },
          "local_registration": {
            "title": "Local Registration",
            "type": "boolean"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/AuthProviderInfo"
            },
            "title": "Providers",
            "type": "array"
          }
        },
        "required": [
          "local_login",
          "local_registration",
          "providers"
        ],
        "title": "AuthProviders",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 1,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "ProfileUpdate": {
        "description": "Fields a user may change on their own account.",
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "language": {
            "anyOf": [
              {
                "enum": [
                  "de",
                  "en"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "timezone": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone"
          }
        },
        "title": "ProfileUpdate",
        "type": "object"
      },
      "ReadinessStatus": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "enum": [
                "ok",
                "failed"
              ],
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessStatus",
        "type": "object"
      },
      "RegisterRequest": {
        "properties": {
          "display_name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "maxLength": 320,
            "title": "Email",
            "type": "string"
          },
          "language": {
            "default": "en",
            "enum": [
              "de",
              "en"
            ],
            "title": "Language",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "timezone": {
            "default": "UTC",
            "maxLength": 64,
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "email",
          "display_name",
          "password"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "SessionRead": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "current": {
            "title": "Current",
            "type": "boolean"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "last_seen_at": {
            "format": "date-time",
            "title": "Last Seen At",
            "type": "string"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "user_agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Agent"
          }
        },
        "required": [
          "id",
          "provider",
          "created_at",
          "last_seen_at",
          "expires_at",
          "user_agent",
          "current"
        ],
        "title": "SessionRead",
        "type": "object"
      },
      "SetupRequest": {
        "properties": {
          "display_name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "maxLength": 320,
            "title": "Email",
            "type": "string"
          },
          "language": {
            "default": "en",
            "enum": [
              "de",
              "en"
            ],
            "title": "Language",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "setup_token": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Setup Token",
            "type": "string"
          },
          "timezone": {
            "default": "UTC",
            "maxLength": 64,
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "setup_token",
          "email",
          "display_name",
          "password"
        ],
        "title": "SetupRequest",
        "type": "object"
      },
      "SetupStatus": {
        "properties": {
          "initialized": {
            "title": "Initialized",
            "type": "boolean"
          }
        },
        "required": [
          "initialized"
        ],
        "title": "SetupStatus",
        "type": "object"
      },
      "UserCreate": {
        "description": "A new local account (admin).",
        "properties": {
          "display_name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "maxLength": 320,
            "title": "Email",
            "type": "string"
          },
          "language": {
            "default": "en",
            "enum": [
              "de",
              "en"
            ],
            "title": "Language",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole",
            "default": "user"
          },
          "timezone": {
            "default": "UTC",
            "maxLength": 64,
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "email",
          "display_name",
          "password"
        ],
        "title": "UserCreate",
        "type": "object"
      },
      "UserRead": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "last_login_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Login At"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "role",
          "language",
          "timezone",
          "is_active",
          "created_at",
          "last_login_at"
        ],
        "title": "UserRead",
        "type": "object"
      },
      "UserRole": {
        "enum": [
          "admin",
          "user"
        ],
        "title": "UserRole",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ollamail",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/login": {
      "post": {
        "description": "Sign in with a local account.",
        "operationId": "auth_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Wrong credentials"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Too many attempts (rate limit or account lockout)"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "description": "End the current session (also without a valid session).",
        "operationId": "auth_logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "description": "The signed-in user.",
        "operationId": "auth_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Not signed in"
          }
        },
        "summary": "Me",
        "tags": [
          "auth"
        ]
      },
      "patch": {
        "description": "Change display name, language or time zone of the own account.",
        "operationId": "auth_update_me",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Not signed in"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/providers": {
      "get": {
        "description": "Sign-in options for the login page.",
        "operationId": "auth_providers",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthProviders"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Providers",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "description": "Create a local account (role ``user``) and sign in, if self-registration is on.",
        "operationId": "auth_register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "description": "Registration is disabled"
          },
          "409": {
            "description": "E-mail address taken or instance not set up"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Too many attempts (rate limit or account lockout)"
          }
        },
        "summary": "Register",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/sessions": {
      "delete": {
        "description": "Sign out all other sessions, or all sessions with ``include_current=true``.",
        "operationId": "auth_revoke_sessions",
        "parameters": [
          {
            "in": "query",
            "name": "include_current",
            "required": false,
            "schema": {
              "default": false,
              "title": "Include Current",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Not signed in"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Revoke Sessions",
        "tags": [
          "auth"
        ]
      },
      "get": {
        "description": "The own active sessions, most recently used first.",
        "operationId": "auth_list_sessions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionRead"
                  },
                  "title": "Response Auth List Sessions",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Not signed in"
          }
        },
        "summary": "List Sessions",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/sessions/{session_id}": {
      "delete": {
        "description": "Sign out one of the own sessions.",
        "operationId": "auth_revoke_session",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Not signed in"
          },
          "404": {
            "description": "No such session"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Revoke Session",
        "tags": [
          "auth"
        ]
      }
    },
    "/events": {
      "get": {
        "description": "Stream the current user's events. Each SSE ``event`` is the event type, ``data``\nthe JSON-encoded event.",
        "operationId": "events_stream_events",
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "additionalProperties": false,
                  "description": "A change notification: what happened to which resources. No content.",
                  "properties": {
                    "ids": {
                      "maxProperties": 8,
                      "patternProperties": {
                        "^[a-z][a-z0-9_]*_id$": {
                          "anyOf": [
                            {
                              "format": "uuid",
                              "type": "string"
                            },
                            {
                              "type": "integer"
                            }
                          ]
                        }
                      },
                      "propertyNames": {
                        "maxLength": 64
                      },
                      "title": "Ids",
                      "type": "object"
                    },
                    "status": {
                      "anyOf": [
                        {
                          "maxLength": 32,
                          "pattern": "^[a-z][a-z0-9_]*$",
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "title": "Status"
                    },
                    "type": {
                      "maxLength": 64,
                      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
                      "title": "Type",
                      "type": "string"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "title": "Event",
                  "type": "object"
                }
              }
            },
            "description": "Server-Sent Events stream of `Event` objects for the current user"
          },
          "503": {
            "description": "The event listener is unavailable"
          }
        },
        "summary": "Stream Events",
        "tags": [
          "events"
        ]
      }
    },
    "/healthz": {
      "get": {
        "description": "Liveness probe: reports that the process is up.",
        "operationId": "health_healthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Readiness probe: 200 if all registered checks pass, otherwise 503.",
        "operationId": "health_readyz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessStatus"
                }
              }
            },
            "description": "A dependency is unavailable"
          }
        },
        "summary": "Readyz",
        "tags": [
          "health"
        ]
      }
    },
    "/setup": {
      "post": {
        "description": "Create the first admin and sign them in. Only possible while no user exists.",
        "operationId": "setup_create_admin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "description": "Wrong setup token"
          },
          "409": {
            "description": "The instance is already set up"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Admin",
        "tags": [
          "setup"
        ]
      }
    },
    "/setup/status": {
      "get": {
        "description": "Whether the instance has been set up (an admin exists).",
        "operationId": "setup_get_status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Status",
        "tags": [
          "setup"
        ]
      }
    },
    "/users": {
      "get": {
        "description": "All users, ordered by e-mail address.",
        "operationId": "users_list_users",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UserRead"
                  },
                  "title": "Response Users List Users",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Not signed in"
          },
          "403": {
            "description": "Not an admin"
          }
        },
        "summary": "List Users",
        "tags": [
          "users"
        ]
      },
      "post": {
        "description": "Create a local account with an initial password.",
        "operationId": "users_create_user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Not signed in"
          },
          "403": {
            "description": "Not an admin"
          },
          "409": {
            "description": "E-mail address taken"
          },
          "422": {
            "content": {
              "application/json": {
