{
  "components": {
    "schemas": {
      "HealthStatus": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "ReadinessStatus": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "enum": [
                "ok",
                "failed"
              ],
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessStatus",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ollamail",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/events": {
      "get": {
        "description": "Stream the current user's events. Each SSE ``event`` is the event type, ``data``\nthe JSON-encoded event.",
        "operationId": "events_stream_events",
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "additionalProperties": false,
                  "description": "A change notification: what happened to which resources. No content.",
                  "properties": {
                    "ids": {
                      "maxProperties": 8,
                      "patternProperties": {
                        "^[a-z][a-z0-9_]*_id$": {
                          "anyOf": [
                            {
                              "format": "uuid",
                              "type": "string"
                            },
                            {
                              "type": "integer"
                            }
                          ]
                        }
                      },
                      "propertyNames": {
                        "maxLength": 64
                      },
                      "title": "Ids",
                      "type": "object"
                    },
                    "status": {
                      "anyOf": [
                        {
                          "maxLength": 32,
                          "pattern": "^[a-z][a-z0-9_]*$",
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "title": "Status"
                    },
                    "type": {
                      "maxLength": 64,
                      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
                      "title": "Type",
                      "type": "string"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "title": "Event",
                  "type": "object"
                }
              }
            },
            "description": "Server-Sent Events stream of `Event` objects for the current user"
          },
          "503": {
            "description": "The event listener is unavailable"
          }
        },
        "summary": "Stream Events",
        "tags": [
          "events"
        ]
      }
    },
    "/healthz": {
      "get": {
        "description": "Liveness probe: reports that the process is up.",
        "operationId": "health_healthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Readiness probe: 200 if all registered checks pass, otherwise 503.",
        "operationId": "health_readyz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessStatus"
                }
              }
            },
            "description": "A dependency is unavailable"
          }
        },
        "summary": "Readyz",
        "tags": [
          "health"
        ]
      }
    }
  }
}
