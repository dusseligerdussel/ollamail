# Production web server: serves the static SPA and proxies /api to the backend.
# TLS is expected to be terminated by an outer reverse proxy (see deploy/README.md).
{
	admin off
	auto_https off
	persist_config off
	# Trust X-Forwarded-* only from private networks (outer reverse proxy, Docker). Strict:
	# the client IP is the right-most X-Forwarded-For entry that is not a trusted proxy, so
	# a value the client sends itself (left of what the outer proxy appends) is ignored.
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

(security_headers) {
	header {
		# Everything is served from this origin: no CDNs, external fonts or telemetry.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}
	# HSTS belongs to the TLS-terminating outer proxy. Optionally sent from here when
	# OLLAMAIL_HSTS holds the header value, e.g. "max-age=31536000; includeSubDomains".
	@hsts expression `{env.OLLAMAIL_HSTS} != ""`
	header @hsts Strict-Transport-Security {env.OLLAMAIL_HSTS}
}

:8080 {
	import security_headers

	# API: strip the /api prefix and forward to FastAPI.
	# Prometheus metrics are for scrapers inside the network (http://api:8000/metrics),
	# never for browsers.
	handle /api/metrics* {
		respond 404
	}

	handle_path /api/* {
		# Compress JSON only (#147). Server-Sent Events (text/event-stream) must reach the
		# browser unbuffered; attachments, audio and exports pass through unchanged.
		encode zstd gzip {
			match {
				header Content-Type application/json*
				header Content-Type application/problem+json*
			}
		}
		reverse_proxy {$OLLAMAIL_API_UPSTREAM:api:8000} {
			# Exactly one value: the client IP determined above. Rate limits key on it.
			header_up X-Forwarded-For {client_ip}
			# Stream responses immediately (SSE: no buffering).
			flush_interval -1
			transport http {
				dial_timeout 5s
				# Long-lived SSE streams (RAG chat, job progress) must not be cut off.
				read_timeout 1h
				write_timeout 1h
			}
		}
	}

	root * /srv

	# Hashed build assets never change. Missing files are real 404s, not the SPA.
	handle /assets/* {
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# SPA: client-side routes resolve to index.html, which must always be revalidated.
	handle {
		encode zstd gzip
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
