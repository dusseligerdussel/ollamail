# ollamail – configuration for deploy/compose.yaml
#
#   cp deploy/.env.example deploy/.env
#
# All application settings use the prefix OLLAMAIL_ (see backend/app/core/config.py).
# Keep sections in place and add new variables to the matching section (or a new one) so
# changes from parallel work merge cleanly. Never commit deploy/.env.

# =============================================================================
# Core
# =============================================================================

# Master key for encrypting stored credentials and tokens (mailbox passwords, OAuth tokens,
# IdP secrets): base64 of at least 32 random bytes. Required – the api refuses to start
# without a valid key. Generate with `openssl rand -base64 32` or
# `docker compose -f deploy/compose.yaml run --rm --no-deps api python -m app.cli generate-key`.
# Keep it secret and back it up; losing it makes stored secrets unreadable.
OLLAMAIL_SECRET_KEY=
# Previous master keys (comma-separated), only needed during a key rotation:
#   1. Move the current key here and set a new OLLAMAIL_SECRET_KEY.
#   2. Restart, then run: docker compose -f deploy/compose.yaml run --rm api python -m app.cli rotate-keys
#   3. Remove the old key from this list and restart.
OLLAMAIL_SECRET_KEYS_OLD=

# Directory for attachments, audio digests and other files inside the containers.
# Compose mounts the `ollamail-data` volume here; only change it outside of Compose.
OLLAMAIL_DATA_DIR=/data

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
OLLAMAIL_LOG_LEVEL=INFO
# json (production) or console (human-readable, local development).
OLLAMAIL_LOG_FORMAT=json

# =============================================================================
# Database
# =============================================================================

# Credentials for the bundled PostgreSQL (pgvector) container.
# The password is only applied on the first start (empty volume). Change it before that.
POSTGRES_USER=ollamail
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ollamail

# PostgreSQL 16 with pgvector; must use the asyncpg driver. Used by api, worker and migrate.
# Must match the values above; URL-encode special characters in the password.
# Point it to an external PostgreSQL 16 with the `vector` extension if you do not use the bundled one.
OLLAMAIL_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# Connection pool per process.
OLLAMAIL_DATABASE_POOL_SIZE=5
OLLAMAIL_DATABASE_MAX_OVERFLOW=10
# Seconds to wait when opening a database connection.
OLLAMAIL_DATABASE_CONNECT_TIMEOUT=5

# =============================================================================
# LLM
# =============================================================================

# Details: docs/ARCHITECTURE.md §3.2. Model names below are examples, not requirements.

# Default endpoint. Provider: ollama (native API) or openai_compatible (vLLM, LM Studio,
# LocalAI, llama.cpp server, OpenAI, gateways).
OLLAMAIL_LLM_PROVIDER=ollama
# Base URL of the Ollama (or OpenAI-compatible) server; for openai_compatible include /v1.
# Default: the bundled container from the `ollama-cpu` / `ollama-gpu` profile.
# Ollama on the Docker host: http://host.docker.internal:11434 (Linux: add extra_hosts).
OLLAMAIL_LLM_BASE_URL=http://ollama:11434
# OLLAMAIL_LLM_API_KEY=
# true if the default endpoint sends data off the instance (then only used with CLOUD_ENABLED).
OLLAMAIL_LLM_IS_CLOUD=false
# native (JSON schema via API) or prompt (servers without schema support).
OLLAMAIL_LLM_STRUCTURED_OUTPUT=native
# Seconds per request (CPU inference of long mails is slow).
OLLAMAIL_LLM_TIMEOUT=300

# Further named endpoints as JSON; reference them in OLLAMAIL_LLM_TASK_<TASK>_ENDPOINT.
# Keys per endpoint: provider, base_url, api_key, is_cloud, structured_output, timeout.
# OLLAMAIL_LLM_ENDPOINTS={"vllm": {"provider": "openai_compatible", "base_url": "http://vllm:8000/v1"}}

# Allow cloud LLM endpoints at all (global admin switch). Default: local only.
OLLAMAIL_LLM_CLOUD_ENABLED=false

# Parallel jobs on the `llm` queue per worker process. Keep at 1 on CPU-only hosts.
OLLAMAIL_LLM_CONCURRENCY=1

# Hardware profile with default models and context size: cpu, gpu-consumer or gpu-server.
OLLAMAIL_LLM_PROFILE=cpu
# Override the profile's models / context window for all tasks.
# OLLAMAIL_LLM_DEFAULT_CHAT_MODEL=qwen2.5:3b
# OLLAMAIL_LLM_DEFAULT_EMBEDDING_MODEL=bge-m3
# OLLAMAIL_LLM_CONTEXT_TOKENS=8192

# Per-task model and endpoint ("default" or a key of OLLAMAIL_LLM_ENDPOINTS).
# Tasks: TRIAGE, TODOS, DIGEST, RAG_CHAT, EMBEDDINGS.
# OLLAMAIL_LLM_TASK_TRIAGE_MODEL=
# OLLAMAIL_LLM_TASK_TRIAGE_ENDPOINT=
# OLLAMAIL_LLM_TASK_DIGEST_MODEL=
# OLLAMAIL_LLM_TASK_DIGEST_ENDPOINT=

# Extra attempts when a model answers with invalid JSON (0-5).
OLLAMAIL_LLM_STRUCTURED_OUTPUT_RETRIES=2
# Add an "llm" check to /readyz (all assigned models available).
OLLAMAIL_LLM_READINESS_CHECK=false
# Pull missing models from Ollama endpoints in the background when the API starts.
OLLAMAIL_LLM_PULL_MISSING_MODELS=false

# =============================================================================
# Authentication
# =============================================================================

# Details: docs/ARCHITECTURE.md §5. The first admin is created in the setup wizard and needs
# a setup token: this value, or – if empty – a token derived from OLLAMAIL_SECRET_KEY that the
# api logs at start-up (event "setup_pending", field "setup_code") while no user exists. Print it
# with `docker compose -f deploy/compose.yaml run --rm --no-deps api python -m app.cli setup-token`.
OLLAMAIL_SETUP_TOKEN=

# Absolute session lifetime and idle timeout in minutes (default 14 days / 3 days).
OLLAMAIL_AUTH_SESSION_LIFETIME_MINUTES=20160
OLLAMAIL_AUTH_SESSION_IDLE_TIMEOUT_MINUTES=4320
# Cookies only over HTTPS. Browsers then reject the login on plain http://<ip>:8080 (except
# http://localhost); set to false only for test setups without TLS.
OLLAMAIL_AUTH_COOKIE_SECURE=true
# Self-service registration of local accounts (role "user"). Admins can always add users.
OLLAMAIL_AUTH_LOCAL_REGISTRATION=false
# Minimum password length for local accounts.
OLLAMAIL_AUTH_PASSWORD_MIN_LENGTH=12
# Lockout: at most this many login attempts per account and window (minutes).
OLLAMAIL_AUTH_LOGIN_MAX_ATTEMPTS=5
OLLAMAIL_AUTH_LOGIN_WINDOW_MINUTES=15
# Login/registration attempts per client IP and window.
OLLAMAIL_AUTH_IP_MAX_ATTEMPTS=50

# =============================================================================
# Mail
# =============================================================================

# Days of mail to import when a mailbox is added.
OLLAMAIL_MAIL_INITIAL_SYNC_DAYS=90
# Allow unencrypted IMAP connections and unverified TLS certificates (test setups only).
# For a mail server with a private CA, provide the CA via SSL_CERT_FILE instead.
OLLAMAIL_MAIL_ALLOW_INSECURE_CONNECTIONS=false
# Seconds to wait for a mail server response before the connection is dropped.
OLLAMAIL_MAIL_IMAP_TIMEOUT=60
# Messages fetched and committed per batch; an interrupted import resumes per batch.
OLLAMAIL_MAIL_SYNC_BATCH_SIZE=50
# Keep one push connection (IMAP IDLE) per mailbox in workers that consume the `sync`
# queue. With `false` mailboxes are not synced automatically.
OLLAMAIL_MAIL_WATCH_ENABLED=true

# --- Microsoft 365 (Microsoft Graph), details: docs/providers/microsoft365.md ---
# Entra ID app registration (one per instance; the OIDC login app can be reused). Without a
# client ID, Microsoft 365 mailboxes are disabled.
OLLAMAIL_MAIL_GRAPH_CLIENT_ID=
OLLAMAIL_MAIL_GRAPH_CLIENT_SECRET=
# Tenant ID. "organizations" allows any work account (delegated only); app-only mailboxes
# (shared mailboxes, org-wide rollout) need the real tenant ID.
OLLAMAIL_MAIL_GRAPH_TENANT_ID=organizations
# Redirect URI as registered in Entra ID (platform "Web"). Empty: derived from the request,
# https://<host>/api/mail/graph/callback.
OLLAMAIL_MAIL_GRAPH_REDIRECT_URI=
# Change notifications (webhooks): public HTTPS URL of /api/mail/graph/notifications that
# Microsoft can reach. Empty (default): polling only, no inbound connections.
OLLAMAIL_MAIL_GRAPH_NOTIFICATION_URL=
# Sign-in and Graph endpoints; change only for national clouds.
OLLAMAIL_MAIL_GRAPH_AUTHORITY=https://login.microsoftonline.com
OLLAMAIL_MAIL_GRAPH_API_URL=https://graph.microsoft.com/v1.0
# Seconds per request; retries after throttling (429/503, honouring Retry-After).
OLLAMAIL_MAIL_GRAPH_TIMEOUT=60
OLLAMAIL_MAIL_GRAPH_MAX_RETRIES=5

# =============================================================================
# TTS
# =============================================================================

# Text-to-speech engine (see docs/OPERATIONS.md, section 3.6).
OLLAMAIL_TTS_ENGINE=piper
# Default voice per language (Piper voice IDs). Users can choose another installed voice
# of the same language. Check the license in the voice's MODEL_CARD before changing.
OLLAMAIL_TTS_VOICE_DE=de_DE-thorsten-medium
OLLAMAIL_TTS_VOICE_EN=en_US-ljspeech-medium
# Download missing voices into /data/tts/voices/piper/ (60-120 MB each, nothing is sent).
# Set to false without internet access and copy <voice>.onnx and <voice>.onnx.json there.
OLLAMAIL_TTS_DOWNLOAD_VOICES=true
OLLAMAIL_TTS_VOICE_BASE_URL=https://huggingface.co/rhasspy/piper-voices/resolve/main
# Seconds per voice download.
OLLAMAIL_TTS_DOWNLOAD_TIMEOUT=600
# Encoding: Opus is the default format, MP3 for podcast apps (bitrates in kbit/s).
OLLAMAIL_TTS_FFMPEG_PATH=ffmpeg
OLLAMAIL_TTS_OPUS_BITRATE_KBPS=32
OLLAMAIL_TTS_MP3_BITRATE_KBPS=64
# Long texts are spoken in pieces of at most this many characters.
OLLAMAIL_TTS_MAX_CHUNK_CHARS=400
# Silence in seconds after a sentence and after a paragraph.
OLLAMAIL_TTS_SENTENCE_PAUSE=0.35
OLLAMAIL_TTS_PARAGRAPH_PAUSE=0.8
# Speaking rate: above 1 is slower, below 1 faster. Unset = voice default.
# OLLAMAIL_TTS_LENGTH_SCALE=1.1

# =============================================================================
# Processing pipeline (triage, todos, index of new mails)
# =============================================================================

# Global switch: false = mails are stored but not processed. Per mailbox:
# `python -m app.cli processing disable <mailbox-id>`.
OLLAMAIL_PROCESSING_ENABLED=true
# Messages queued per run (every 10 minutes) of the job that re-processes mails after a
# step changed its version, or that were never processed.
OLLAMAIL_PROCESSING_REQUEUE_BATCH_SIZE=500

# =============================================================================
# Todos (extraction of tasks from mails)
# =============================================================================

# Pipeline step on/off. Manually created todos keep working when off.
OLLAMAIL_TODOS_EXTRACTION_ENABLED=true
# Triage categories whose mails are not searched for todos, comma-separated.
# Mails without a triage result are always searched.
OLLAMAIL_TODOS_SKIP_CATEGORIES=newsletter,notification,spam
# Extracted todos below this model confidence (0-1) are discarded.
OLLAMAIL_TODOS_MIN_CONFIDENCE=0.5

# =============================================================================
# Worker (background jobs)
# =============================================================================

# Queues this worker consumes, comma-separated: sync, llm, tts, default.
# E.g. run a second worker container with only `llm` on a GPU host.
OLLAMAIL_WORKER_QUEUES=sync,llm,tts,default
# Parallel jobs for all queues except `llm` (see OLLAMAIL_LLM_CONCURRENCY).
OLLAMAIL_WORKER_CONCURRENCY=4
# Seconds running jobs get to finish on shutdown (SIGTERM) before they are cancelled.
# Keep below the `stop_grace_period` of the worker service in compose.yaml (45s).
OLLAMAIL_WORKER_SHUTDOWN_TIMEOUT=30

# =============================================================================
# Deployment (Compose only, not read by the application)
# =============================================================================

# Host interface and port of the web UI. Use 127.0.0.1 behind a reverse proxy on the same host.
OLLAMAIL_HTTP_BIND=0.0.0.0
OLLAMAIL_HTTP_PORT=8080

# Tag of the published GHCR images (ghcr.io/dusseligerdussel/ollamail-{api,frontend}):
# latest (newest stable release), a version such as 1.2.3 / 1.2 / 1, or edge (current main).
# The repository is private, so pulling needs `docker login ghcr.io` (see deploy/README.md).
# OLLAMAIL_VERSION=latest
# Full image references; override OLLAMAIL_VERSION (e.g. for a mirror registry).
# Ignored with deploy/compose.build.yaml, which builds locally.
# OLLAMAIL_API_IMAGE=ghcr.io/dusseligerdussel/ollamail-api:latest
# OLLAMAIL_FRONTEND_IMAGE=ghcr.io/dusseligerdussel/ollamail-frontend:latest
# POSTGRES_IMAGE=pgvector/pgvector:pg16
# OLLAMA_IMAGE=ollama/ollama:0.35.0
